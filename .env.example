# Flask secret key
SECRET_KEY=change-me

# MongoDB Atlas connection URI
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/?appName=Cluster0
MONGO_DBNAME=lepaix

# Admin login seed
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Optional test MongoDB URI
TEST_MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/?appName=Cluster0
TEST_MONGO_DBNAME=lepaix_test

# Cloudinary (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Outgoing mail — order confirmation + vendor notification.
# Leave MAIL_SERVER blank to disable order emails entirely.
# Gmail: smtp.gmail.com / 587, and MAIL_PASSWORD must be a 16-character
# App Password (https://myaccount.google.com/apppasswords), not your login.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=orders@yourdomain.com
MAIL_PASSWORD=your_app_password
# Display name + address buyers see. Defaults to MAIL_USERNAME if unset.
MAIL_DEFAULT_SENDER=Lepaix <orders@yourdomain.com>
# Where "New order placed" notifications go. Defaults to MAIL_USERNAME if unset.
VENDOR_EMAIL=you@yourdomain.com
# Optional: 465 sets SSL automatically, 587 sets STARTTLS. Override only if needed.
# MAIL_USE_TLS=true
# MAIL_USE_SSL=false
# MAIL_TIMEOUT=20
