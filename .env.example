# Flask secret key
SECRET_KEY=change-me

# MongoDB Atlas connection URI
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/?appName=Cluster0
MONGO_DBNAME=lepaix

# Admin login seed
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Optional test MongoDB URI
TEST_MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/?appName=Cluster0
TEST_MONGO_DBNAME=lepaix_test

# Cloudinary (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Outgoing mail — order confirmation, vendor notification, shipping notice.
# Sent via Resend (https://resend.com) over HTTPS. Railway blocks outbound
# SMTP, so raw Gmail SMTP does not work in production.
# Leave RESEND_API_KEY blank to disable order emails entirely.
RESEND_API_KEY=re_your_api_key
# The "from" address buyers see. MUST be on a domain you verified in Resend
# (Domains → add domain → set the SPF/DKIM DNS records). A @gmail.com sender
# will be rejected.
MAIL_DEFAULT_SENDER=Lepaix <orders@yourdomain.com>
# Where "New order placed" notifications go. Any address is fine (Gmail OK).
VENDOR_EMAIL=you@yourdomain.com
# Optional: seconds before a hung request to Resend gives up.
# MAIL_TIMEOUT=20
